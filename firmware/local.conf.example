# Local, machine-specific configuration. Copy to firmware/local.conf and fill
# in your own values, then build with:
#
#   west build -b nrf9161dk/nrf9161/ns -p always firmware -- -DEXTRA_CONF_FILE=local.conf
#
# local.conf is git-ignored on purpose: it holds identifiers specific to your
# AWS account and your SIM.

# APN of your LTE-M SIM. Leave empty to let the network supply it.
CONFIG_EBIKE_APN=""
